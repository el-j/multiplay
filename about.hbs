<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>multiplay: third-party licenses</title>
<style>
  :root { color-scheme: light dark; --fg: #1d1d1f; --bg: #fbfbfd; --muted: #6e6e73; --card: #fff; --line: #e3e3e8; }
  @media (prefers-color-scheme: dark) { :root { --fg: #e8e8ed; --bg: #111114; --muted: #9a9aa2; --card: #1b1b20; --line: #2c2c33; } }
  body { margin: 0 auto; max-width: 960px; padding: 24px 16px 64px; font: 15px/1.5 system-ui, sans-serif; color: var(--fg); background: var(--bg); }
  h1 { font-size: 1.6rem; margin-bottom: 4px; }
  p.lead { color: var(--muted); margin-top: 0; }
  ul.overview { columns: 2; padding-left: 20px; }
  @media (max-width: 600px) { ul.overview { columns: 1; } }
  section.license { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 12px 16px; margin: 16px 0; }
  section.license h3 { margin: 4px 0 8px; }
  ul.crates { padding-left: 20px; font-size: 0.9rem; color: var(--muted); }
  pre { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 0.8rem; max-height: 24em; overflow: auto; border-top: 1px solid var(--line); padding-top: 8px; }
  a { color: inherit; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p class="lead">multiplay is built from these open-source Rust crates. Thank you to everyone who wrote them.
Each license below lists the crates (and versions) it covers.</p>
<h2>Overview</h2>
<ul class="overview">
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>License texts</h2>
{{#each licenses}}
<section class="license">
  <h3 id="{{id}}">{{name}}</h3>
  <ul class="crates">
  {{#each used_by}}
    <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
  {{/each}}
  </ul>
  <pre>{{text}}</pre>
</section>
{{/each}}
</body>
</html>
